Dictionary PremixedLaminarFlame1D
{
	@Type					FlameSpeed;
	@KineticsFolder kinetics ;	
	@InletStream 	inlet-stream;
	@OutletStream	outlet-stream;	
	@InletVelocity	55 cm/s;	
	@Grid			grid;	
	@Output			Output;	
	@UseDaeSolver	true;
//	@Backup		Output/Output.xml;
//@SensitivityAnalysis    sensitivity-options;
}

Dictionary inlet-stream
{
	@EquivalenceRatio	1.2 1.3 1.2 1.1 1.0 0.9 0.8 0.7 ;
	@FuelMoles			C6H6 1;
	@OxidizerMoles		O2 0.21 N2 0.79 ;		
	@Temperature	423 K;
	@Pressure		5 atm;
}

Dictionary outlet-stream
{
	@Moles			 CO2   7   H2O   4   N2   36;
	@Temperature	2300 K;
	@Pressure		5 atm;
}

Dictionary grid
{
	@Length					3 cm;
	@InitialPoints			12;
	@Type					centered;
	@MaxPoints				500;
	@MaxAdaptivePoints		15;
	@GradientCoefficient	0.05;
	@CurvatureCoefficient	0.5;
}